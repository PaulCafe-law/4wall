# Only known production aliases migrate; local and staging hosts keep their routes.
map $host $legacy_platform_origin {
    default "";
    4wall.io https://platform.4wall.io;
    www.4wall.io https://platform.4wall.io;
    four-wall-web.onrender.com https://platform.4wall.io;
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    charset_types text/html text/xml text/plain text/markdown application/xml application/rss+xml application/javascript application/json;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location = /robots.txt {
        try_files /robots.txt =404;
        default_type text/plain;
        add_header Cache-Control "public, max-age=3600";
    }

    location = /llms.txt {
        try_files /llms.txt =404;
        default_type text/plain;
        add_header Cache-Control "public, max-age=3600";
    }

    location = /official.md {
        try_files /official.md =404;
        default_type text/markdown;
        add_header Cache-Control "public, max-age=3600";
    }

    location = /sitemap.xml {
        try_files /sitemap.xml =404;
        default_type application/xml;
        add_header Cache-Control "public, max-age=3600";
    }

    location = /official {
        try_files /official/index.html =404;
        add_header Cache-Control "no-store";
    }

    location = /official/ {
        try_files /official/index.html =404;
        add_header Cache-Control "no-store";
    }

    location = /official/en {
        try_files /official/en/index.html =404;
        add_header Cache-Control "no-store";
    }

    location = /official/en/ {
        try_files /official/en/index.html =404;
        add_header Cache-Control "no-store";
    }

    location /official-assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The platform owns its app entry; the public website keeps its marketing root.
    location = / {
        absolute_redirect off;
        if ($host != platform.4wall.io) {
            return 301 /official;
        }
        try_files /index.html =404;
        add_header Cache-Control "no-store";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location = /index.html {
        if ($legacy_platform_origin) {
            return 302 $legacy_platform_origin$request_uri;
        }
        try_files /index.html =404;
        add_header Cache-Control "no-store";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    # The login form lives at the canonical hostname root, without /login.
    location = /login {
        if ($legacy_platform_origin) {
            return 302 $legacy_platform_origin/$is_args$args;
        }
        if ($host = platform.4wall.io) {
            return 302 https://platform.4wall.io/$is_args$args;
        }
        try_files /index.html =404;
        add_header Cache-Control "no-store";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location / {
        try_files $uri $uri/ @platform;
        add_header Cache-Control "no-store";
    }

    # Preserve deep links and query strings, including invite and LINE flows.
    # Keeping this at the SPA fallback also covers future application routes.
    location @platform {
        if ($legacy_platform_origin) {
            return 302 $legacy_platform_origin$request_uri;
        }
        try_files /index.html =404;
        add_header Cache-Control "no-store";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }
}
