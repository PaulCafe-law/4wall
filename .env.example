# 4WALL Industrial Data Engine

# Do NOT use OPENAI_API_KEY in this project.
# Codex development should use ChatGPT OAuth login via Codex CLI/App/IDE.
# Run: codex login

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-pro

WORLDLABS_API_KEY=
WORLDLABS_MODEL=marble-1.1-plus

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_QWEN_VLM_MODEL=qwen2.5vl:7b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

STORAGE_PROVIDER=local
STORAGE_BASE_PATH=./storage/industrial-data-engine

DATABASE_URL=

BOXER_REPO_PATH=
BOXER_CHECKPOINT_PATH=
BOXER_ANNOTATION_COMMAND=
GSPLAT_PYTHON_ENV=
GSPLAT_RENDER_COMMAND=

ENABLE_EGO_PLANNER=false
EGO_PLANNER_ROS_WORKSPACE=
EGO_PLANNER_COMMAND=

INDUSTRIAL_ENGINE_MAX_SCENES_PER_RUN=1
INDUSTRIAL_ENGINE_MAX_INCIDENTS_PER_SCENE=5
INDUSTRIAL_ENGINE_MAX_CAMERA_POSES=48
