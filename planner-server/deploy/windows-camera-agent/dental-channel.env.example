CAMERA_AGENT_API_BASE_URL=https://four-wall-api.onrender.com
CAMERA_AGENT_DEVICE_TOKEN=REPLACE_WITH_FWCAM_DEVICE_TOKEN
CAMERA_AGENT_FRAME_SOURCE=http_snapshot
CAMERA_AGENT_SNAPSHOT_URL=http://192.168.0.10:554/cgi-bin/guest/Video.cgi?media=JPEG&channel=1
CAMERA_AGENT_SNAPSHOT_USERNAME=REPLACE_WITH_DVR_USERNAME
CAMERA_AGENT_SNAPSHOT_PASSWORD=REPLACE_WITH_DVR_PASSWORD
CAMERA_AGENT_SPOOL_DIR=C:\ProgramData\FourWall\camera-agent\spool\channel1
CAMERA_AGENT_FFMPEG_PATH=ffmpeg
CAMERA_AGENT_INTERVAL_SECONDS=10
CAMERA_AGENT_LOCAL_SPOOL_HOURS=24
CAMERA_AGENT_HTTP_TIMEOUT_SECONDS=30
CAMERA_AGENT_TIMESTAMP_OVERLAY_ENABLED=false
CAMERA_AGENT_TIMESTAMP_OVERLAY_TIMEZONE=Asia/Taipei
